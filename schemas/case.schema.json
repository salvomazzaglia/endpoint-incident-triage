{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaseMetadata",
  "type": "object",
  "required": [
    "case_id",
    "collection_id",
    "started_at_utc",
    "source_mode",
    "platform",
    "profile"
  ],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "collection_id": { "type": "string" },
    "authorization_reference": { "type": "string" },
    "operator_label": { "type": "string" },
    "collection_reason": { "type": "string" },
    "target_label": { "type": "string" },
    "started_at_utc": { "type": "string" },
    "completed_at_utc": { "type": ["string", "null"] },
    "source_mode": { "enum": ["live", "synthetic", "fixture"] },
    "platform": { "type": "string" },
    "tool_version": { "type": "string" },
    "profile": { "enum": ["minimal", "standard"] },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
